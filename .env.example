# Copy to .env for docker compose. Everything is optional except SECRET_KEY in production.
SECRET_KEY=change-me
POSTGRES_PASSWORD=enermod
# Supabase (or any managed PostgreSQL): paste the connection string here and drop the db service.
# postgres:// and postgresql:// URLs are rewritten to the psycopg driver automatically.
# DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
BASE_URL=http://localhost:3000             # public URL of the web app (links in e-mails)
NEXT_PUBLIC_SITE_URL=https://enermod.africa
NEXT_PUBLIC_CONTACT_EMAIL=
COOKIE_SECURE=false                        # true behind HTTPS

# Curators: these e-mails become administrators when they sign in (password or magic link)
ADMIN_EMAILS=you@example.org

# E-mail: console (logs only, development) | resend | smtp
EMAIL_PROVIDER=console
EMAIL_FROM=EnerMod Africa <no-reply@enermod.africa>
NOTIFY_EMAIL=                              # curators' inbox for new contributions
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Assistant: auto picks the first configured provider (claude, gemini, deepseek); none disables it.
AI_PROVIDER=auto
AI_MODEL=                                  # empty = provider default (claude-opus-5-5, gemini-2.5-flash, deepseek-chat)
AI_EFFORT=low                              # Claude reasoning effort for chat answers: low | medium | high
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Discovery (OpenAlex polite pool asks for a contact e-mail)
OPENALEX_MAILTO=you@example.org
DISCOVERY_AUTO=false                       # true: the worker re-runs the search every DISCOVERY_INTERVAL_DAYS
DISCOVERY_INTERVAL_DAYS=7

# Tool tracker (GitHub API; a token raises the rate limit from 60 to 5000 requests per hour)
GITHUB_TOKEN=
METRICS_AUTO=false                         # true: the worker refreshes repository metrics monthly

# Survey connector: a CSV URL (a published Google Sheet works) and an optional column mapping
SURVEY_CSV_URL=
SURVEY_FIELD_MAP={"full_title": "Title of the study", "link_doi": "DOI or link", "tools": "Tools used", "countries": "Countries"}
